{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug cpu-power",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/cpu-power",
      "args": ["set", "--governor", "performance", "--cpu", "0"],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "cmake-build-debug"
    }
  ]
}